# Non-secret values for scripts/ops. Copy to scripts/ops/ops.env (gitignored) and fill in.
# The AWS access keys are NOT here; they live in the AWS CLI profile named below.
AWS_PROFILE=crewbie-ops
AWS_REGION=us-east-2
INSTANCE_ID=i-0123456789abcdef0
SECURITY_GROUP_ID=sg-0123456789abcdef0
ELASTIC_IP=203.0.113.10
CREWBIE_HOSTNAME=203-0-113-10.sslip.io
SSH_KEY_PATH=~/.ssh/crewbie-key.pem
SSH_USER=ubuntu
REMOTE_DIR=/opt/crewbie
GIT_BRANCH=crewbie-v2
