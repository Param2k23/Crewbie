# Copy to .env for local runs. Never commit .env.
CREWBIE_ENV=dev                      # dev | prod
CREWBIE_PUBLIC_URL=http://localhost:8000
CREWBIE_DATABASE_URL=sqlite:///./data/crewbie.db
CREWBIE_TIMEZONE=America/Phoenix
CREWBIE_HOST=127.0.0.1               # use 0.0.0.0 in a container
CREWBIE_PORT=8000                    # most hosts set PORT instead; PORT wins
CREWBIE_TRUST_PROXY=false            # true behind a platform proxy (reads X-Forwarded-For)
CREWBIE_ENVELOPE_KEY=                # Fernet key; auto-generated in dev if empty, required in prod
CREWBIE_ADMIN_TOKEN=                 # empty disables admin endpoints

# Discord (Phase 4)
CREWBIE_DISCORD_TOKEN=
CREWBIE_DISCORD_APP_ID=
CREWBIE_DISCORD_GUILD_ID=
CREWBIE_DISCORD_BOARD_CHANNEL_ID=
CREWBIE_DISCORD_CREWS_CHANNEL_ID=
CREWBIE_DISCORD_INVITE_URL=
CREWBIE_DISCORD_TEST_CHANNEL_ID=     # optional: only for `pytest -m discord_live`
CREWBIE_DISCORD_ENABLED=false        # run API without the bot

# LLM (Phase 7)
CREWBIE_LLM_MODE=off                 # on | off
CREWBIE_LLM_MODEL=                   # current Claude Sonnet model string from Anthropic docs
ANTHROPIC_API_KEY=

# Tuning
CREWBIE_OFFER_TTL_MINUTES=15
CREWBIE_MATCH_TIME_BUDGET_SECONDS=10
CREWBIE_MAX_CANDIDATE_ROOMS=3
CREWBIE_MAX_ROUNDS=3

# Mission Control (apps/web), read by Next.js only. Not used by the Python server.
# NEXT_PUBLIC_CREWBIE_API_URL=http://localhost:8000
