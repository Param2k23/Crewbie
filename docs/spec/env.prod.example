# Production values for the EC2 instance. Copy to .env.prod locally (gitignored),
# fill secrets, then run scripts/ops/push-env. Never commit the filled file.
CREWBIE_ENV=prod
CREWBIE_PUBLIC_URL=https://<CREWBIE_HOSTNAME>
CREWBIE_HOSTNAME=<CREWBIE_HOSTNAME>
CREWBIE_TIMEZONE=America/Phoenix
CREWBIE_ENVELOPE_KEY=
CREWBIE_ADMIN_TOKEN=

CREWBIE_DISCORD_ENABLED=true
CREWBIE_DISCORD_TOKEN=
CREWBIE_DISCORD_APP_ID=
CREWBIE_DISCORD_GUILD_ID=
CREWBIE_DISCORD_BOARD_CHANNEL_ID=
CREWBIE_DISCORD_CREWS_CHANNEL_ID=
CREWBIE_DISCORD_INVITE_URL=

CREWBIE_LLM_MODE=off
CREWBIE_LLM_MODEL=
ANTHROPIC_API_KEY=
